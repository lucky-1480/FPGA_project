// J280 控制器基于 GW2A-55 的物理引脚约束。
// Bank 2/4/5 使用 3.3 V；Bank 3（按键、拨码开关、LED）使用 1.5 V。

// 50 MHz 系统时钟。
IO_LOC "clk_50M" M19;
IO_PORT "clk_50M" IO_TYPE=LVCMOS33 PULL_MODE=NONE;

// SW5 复位，低有效。
IO_LOC "rst_n" AB3;
IO_PORT "rst_n" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// 3PA1030 ADC。
IO_LOC "adc_oe_n" H20;
IO_PORT "adc_oe_n" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "adc_clk" G18;
IO_PORT "adc_clk" IO_TYPE=LVCMOS33 PULL_MODE=NONE;

IO_LOC "adc_d[0]" L21;
IO_LOC "adc_d[1]" M21;
IO_LOC "adc_d[2]" J20;
IO_LOC "adc_d[3]" J19;
IO_LOC "adc_d[4]" D19;
IO_LOC "adc_d[5]" H18;
IO_LOC "adc_d[6]" H19;
IO_LOC "adc_d[7]" G19;
IO_LOC "adc_d[8]" G17;
IO_LOC "adc_d[9]" E19;
IO_PORT "adc_d[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_PORT "adc_d[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_PORT "adc_d[2]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_PORT "adc_d[3]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_PORT "adc_d[4]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_PORT "adc_d[5]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_PORT "adc_d[6]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_PORT "adc_d[7]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_PORT "adc_d[8]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_PORT "adc_d[9]" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "adc_otr" F18;
IO_PORT "adc_otr" IO_TYPE=LVCMOS33 PULL_MODE=NONE;

// 编码器接口：XH1 与 XH2。
IO_LOC "enc_a" Y20;
IO_PORT "enc_a" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC "enc_b" AA20;
IO_PORT "enc_b" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC "enc_a2" W18;
IO_PORT "enc_a2" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC "enc_b2" W17;
IO_PORT "enc_b2" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// TB6612 驱动 A 通道。
IO_LOC "pwm_a" Y18;
IO_PORT "pwm_a" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "ain1" Y17;
IO_PORT "ain1" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "ain2" Y19;
IO_PORT "ain2" IO_TYPE=LVCMOS33 PULL_MODE=NONE;

// 按键 SW1~SW4。
IO_LOC "key[0]" T18;
IO_LOC "key[1]" R18;
IO_LOC "key[2]" U20;
IO_LOC "key[3]" T20;
IO_PORT "key[0]" IO_TYPE=LVCMOS15 PULL_MODE=UP;
IO_PORT "key[1]" IO_TYPE=LVCMOS15 PULL_MODE=UP;
IO_PORT "key[2]" IO_TYPE=LVCMOS15 PULL_MODE=UP;
IO_PORT "key[3]" IO_TYPE=LVCMOS15 PULL_MODE=UP;

// 拨码开关。
IO_LOC "dip[0]" W20;
IO_LOC "dip[1]" V20;
IO_PORT "dip[0]" IO_TYPE=LVCMOS15 PULL_MODE=UP;
IO_PORT "dip[1]" IO_TYPE=LVCMOS15 PULL_MODE=UP;

// LED 指示灯。
IO_LOC "led[0]" U18;
IO_LOC "led[1]" U19;
IO_LOC "led[2]" U17;
IO_LOC "led[3]" T17;
IO_PORT "led[0]" IO_TYPE=LVCMOS15 PULL_MODE=NONE;
IO_PORT "led[1]" IO_TYPE=LVCMOS15 PULL_MODE=NONE;
IO_PORT "led[2]" IO_TYPE=LVCMOS15 PULL_MODE=NONE;
IO_PORT "led[3]" IO_TYPE=LVCMOS15 PULL_MODE=NONE;

// 板载 CH340 串口：K20 = FPGA 发送，L20 = FPGA 接收。
IO_LOC "uart_txd" K20;
IO_PORT "uart_txd" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "uart_rxd" L20;
IO_PORT "uart_rxd" IO_TYPE=LVCMOS33 PULL_MODE=UP;
